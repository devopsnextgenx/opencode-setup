{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-local/legion",
  "small_model": "llama-local/legion",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/admn/git",
        "/home/shared"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "browse": {
      "type": "local",
      "command": [
        "/home/kira/.local/bin/browse",
        "mcp"
      ],
      "environment": {
        "OPENCODE_BROWSER_RUNTIME": "auto-update"
      },
      "enabled": true
    }
  },
  "agent": {
    "refactorer": {
      "description": "Refactors code for better structure and readability",
      "mode": "subagent",
      "model": "llama-local/legion",
      "prompt": "{file:./prompts/refactorer.txt}",
      "permission": { "edit": "deny" }
    },
    "reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "llama-local/legion",
      "prompt": "{file:./prompts/reviewer.txt}",
      "permission": { "edit": "deny" }
    },
    "novelist": {
      "description": "Orchestrates writing a multi-chapter novel from novel.spec.yml using the novel-writer skill",
      "mode": "primary",
      "model": "llama-local/legion128k",
      "temperature": 0.7,
      "prompt": "{file:./prompts/novelist.txt}",
      "tools": { "task": true },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": { "novel-writer": "allow" },
        "task": {
          "*": "deny",
          "plot-agent": "allow",
          "chapter-writer": "allow"
        }
      }
    },
    "plot-agent": {
      "description": "Generates the chapter-by-chapter plot outline for a novel from novel.spec.yml",
      "mode": "subagent",
      "model": "llama-local/legion128k",
      "temperature": 0.8,
      "prompt": "{file:./prompts/plot-agent.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": { "novel-writer": "allow" }
      }
    },
    "chapter-writer": {
      "description": "Writes one chapter of the novel from the outline and story bible, in parts, hitting the target word count",
      "mode": "subagent",
      "model": "llama-local/legion128k",
      "temperature": 0.9,
      "prompt": "{file:./prompts/chapter-writer.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": { "novel-writer": "allow" }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "internal-*": "deny",
      "experimental-*": "ask"
    }
  },
  "session": {
    "thinking": "show"
  },
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp ROCm - Local",
      "options": {
        "baseURL": "http://192.168.12.211:9874/v1"
      },
      "models": {
        "legion": {
          "name": "legion (ROCm)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "legion128k": {
          "name": "legion (ROCm) 128k",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  }
}