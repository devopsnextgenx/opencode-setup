{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-local/legion",
  "small_model": "llama-local/legion",
  "keybinds": {
    "display_thinking": "ctrl+shift+t"
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/admn/git",
        "/home/shared"
      ],
      "enabled": true
    }
  },
  "agent": {
    "title": { "model": "llama-local/legion" },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "llama-local/legion",
      "prompt": "{file:./prompts/reviewer.txt}",
      "permission": { "edit": "deny" }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "internal-*": "deny",
      "experimental-*": "ask"
    }
  },
  "session": {
    "thinking": "show"
  },
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp ROCm - Local",
      "options": {
        "baseURL": "http://192.168.12.211:9874/v1"
      },
      "models": {
        "legion": {
          "name": "legion (ROCm)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "legion128k": {
          "name": "legion (ROCm) 128k",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  }
}